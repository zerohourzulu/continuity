    "test:conformance": "python3 -B -m unittest discover -s conformance -p test_runner.py -v",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "recorded": "node examples/recorded.mjs",
    "start": "node tutorial/start.mjs",
    "sdk:build": "node tools/build-sdk.mjs --pack",
    "sdk:verify": "node tools/verify-sdk.mjs",
    "case": "node tools/case.mjs",
    "test:api": "node --test tests/core-0.3/*.test.mjs",
    "api:build": "node tools/build-core-0.3.mjs --pack",
    "api:verify": "node tools/verify-core-0.3.mjs",
    "mcp:build": "node tools/build-mcp.mjs",
    "mcp:verify": "node tools/verify-mcp-package.mjs"
