  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "demo": "node tutorial/cli.mjs run",
    "inspect": "node tutorial/cli.mjs inspect",
